APP_NAME=AI Gateway Platform
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_platform
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SECRET_KEY=your-secret-key-change-in-production
HIGRESS_ADMIN_API=http://localhost:8080/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 网关高并发调优 ----
# API 侧数据库连接池。容量应 >= 预期并发流数量，且不超过 Postgres max_connections。
# 经验值：流式并发 100 路 → pool_size 20 + max_overflow 30（默认值），并按需调大 Postgres。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
# 到上游模型的共享 HTTP 连接池（复用 TCP，避免每请求重新握手）
HTTP_POOL_MAX_CONNECTIONS=200
HTTP_POOL_MAX_KEEPALIVE=50
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=300
# Key last_used_at 落库降频窗口（秒）；0 = 每请求都写（高并发不建议）
KEY_LAST_USED_THROTTLE_SECONDS=60

# ---- 模型压测 ----
PERF_MAX_PARALLEL=500
PERF_MAX_NUMBER=50000
PERF_TASK_TIMEOUT=1800
PERF_WORKER_CONCURRENCY=2
PERF_PROGRESS_INTERVAL=5
PERF_OUTPUTS_DIR=/app/perf_outputs
PERF_REDIS_PREFIX=perf
# 经网关压测时打向的平台地址（worker 与 api-server 同网络）
PERF_GATEWAY_BASE_URL=http://llm-ops-api:8000/v1
# 经网关压测必须配一个平台 AppKey
PERF_GATEWAY_API_KEY=
# 允许压测的模型 provider 前缀白名单（逗号分隔）。
# **留空 = 不限制**（平台默认策略，见交接文档「彻底取消压测模型限制」）。
# 只有需要禁止压测某类模型时才填，例如：local-,vllm
PERF_TESTABLE_PROVIDER_PREFIX=

# ---- 账号与建表 ----
# 开发模式直连登录（/api/v1/system/dev-login，不校验密码）。
# 前端登录页目前只走这个接口，接 SSO 前必须 true；接好后立刻改 false。
ENABLE_DEV_LOGIN=true
# 首次启动自动建表（create_all），已有表不受影响
AUTO_CREATE_TABLES=false
