# ============================================================
# 大模型监测管理平台 — 环境变量配置
# 复制为 .env 后按需修改，切勿提交真实密码到 Git！
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=llmops
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=ai_platform
# 最大连接数（镜像默认 100，不够）。
# 估算：API 池上限 = API_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + Celery 并发 + 余量
# 默认 2×(20+30)=100 + 9 + 余量 → 取 200
POSTGRES_MAX_CONNECTIONS=200

# ---------- Redis ----------
REDIS_PASSWORD=change_me_to_strong_password

# ---------- RabbitMQ ----------
RABBITMQ_USER=llmops
RABBITMQ_PASSWORD=change_me_to_strong_password

# ---------- 应用安全 ----------
# JWT 密钥：生产必须替换为随机长串，例如：openssl rand -hex 32
SECRET_KEY=please_change_me_to_random_secret
JWT_EXPIRE_MINUTES=60

# 开发模式直连登录（POST /api/v1/system/dev-login，不校验密码，签发任意角色 JWT）。
# ⚠️ 前端登录页目前**只调用这个接口**（尚未接 SSO）。所以：
#    - 接入 SSO/真实账号体系之前：必须保持 true，否则全平台无人能登录；
#    - 接入之后：立刻改为 false，这是当前最需要补的安全缺口。
#      在改 false 之前，任何能访问前端的人点一下登录就是 admin。
ENABLE_DEV_LOGIN=true

# 首次启动自动建表（create_all）。已有表不受影响；生产建议改 Alembic 后置 false。
AUTO_CREATE_TABLES=true

# ---------- CORS（前端来源，逗号分隔）----------
CORS_ORIGINS=http://localhost

# ---------- 端口 ----------
# 前端对外端口（80 默认；如 80 被占用改本机实际端口，当前服务器口径为 8085）
WEB_PORT=80

# ---------- 运行参数 ----------
API_WORKERS=2
CELERY_CONCURRENCY=4
DEPLOY_CONCURRENCY=2

# ---------- 模型部署 ----------
# 推理引擎镜像（首次部署会自动拉取，约 8GB，耐心等）
DEPLOY_VLLM_IMAGE=vllm/vllm-openai:v0.6.4.post1
# 推理容器对外发布的宿主机端口区间（网关内部走容器名，此端口仅供外部直连调试）
DEPLOY_PORT_RANGE_START=31100
DEPLOY_PORT_RANGE_END=31299
# 容器启动到就绪的最长等待秒数（大模型首次加载较慢，7B 建议 ≥600）
DEPLOY_READY_TIMEOUT=600

# ---------- 网关高并发调优 ----------
# API 侧数据库连接池。注意：网关的流式/非流式请求都会在等上游生成**之前**归还连接，
# 所以这里只需覆盖"同时进行的查询数"（毫秒级），不再需要 >= 并发请求数。
# 池子只是上限保险，按 POSTGRES_MAX_CONNECTIONS 预算即可。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
# 连接回收时间（秒）：防止拿到被 Postgres 单方面掐掉的死连接
DB_POOL_RECYCLE=1800
# 到上游模型的共享 HTTP 连接池（每个 worker 各自一份，2 worker = 最多 2×200 条）
# 真实有效上限由上游推理引擎的 --max-num-seqs 决定，设再大也没用
HTTP_POOL_MAX_CONNECTIONS=200
HTTP_POOL_MAX_KEEPALIVE=50
HTTP_CONNECT_TIMEOUT=10
# 上游读超时（秒），作用于两次 chunk 之间；即"单次生成最长多久没吐字就判失败"。
# ⚠️ 必须小于 nginx 的 proxy_read_timeout（frontend/nginx.conf 已设 600s），
#    否则 nginx 会先掐成 504，看不到后端的超时日志。
HTTP_READ_TIMEOUT=300
# Key last_used_at 降频落库窗口（秒）
KEY_LAST_USED_THROTTLE_SECONDS=60

# ---------- 模型压测 ----------
# 构建 perf-worker 时用的 PyPI 镜像源。
# ⚠️ 国内部署必须设置，否则 evalscope 依赖（约 200MB+）下载极慢甚至超时。
#   阿里云: https://mirrors.aliyun.com/pypi/simple/
#   清华:   https://pypi.tuna.tsinghua.edu.cn/simple
# 留空 = 官方 PyPI
PIP_INDEX_URL=
# 压测引擎版本（首次构建成功后建议锁定，避免上游 breaking change）
# 首次不填 = 装最新版；届时用 `docker run --rm llm-ops-perf pip show evalscope` 查实际版本回填
EVALSCOPE_VER=
# tokenizer 下载源。random 数据集需要 tokenizer，国内建议走镜像。
# 若服务器可直连 HuggingFace，改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
# perf-worker 同时执行任务数
PERF_WORKER_CONCURRENCY=2
# 单任务并发上限 / 请求数上限 / 硬超时（秒）
PERF_MAX_PARALLEL=500
PERF_MAX_NUMBER=50000
PERF_TASK_TIMEOUT=1800
# 经网关压测时使用的平台 API Key（需先在 Key 管理里创建一个）
PERF_GATEWAY_API_KEY=
# 经网关压测时打向的地址（perf-worker 与 api-server 同网络，用容器名）
PERF_GATEWAY_BASE_URL=http://llm-ops-api:8000/v1
# 进度回写间隔（秒），影响详情页进度条刷新粒度
PERF_PROGRESS_INTERVAL=5
# tokenizer 源：1 = ModelScope（国内可用），0 = HuggingFace（需 HF_ENDPOINT 可达）
USE_MODELSCOPE_HUB=1
# 可压测模型的 provider 前缀白名单（逗号分隔，大小写不敏感）。
# **留空 = 不限制**（平台默认策略）。只有需要禁止压测某类模型时才填，如 local-,vllm
PERF_TESTABLE_PROVIDER_PREFIX=

# ---------- Higress ----------
# 网关控制面地址（本项目后端需要向 Higress 同步路由时使用）
HIGRESS_ADMIN_API=http://higress-gateway:8080/api
