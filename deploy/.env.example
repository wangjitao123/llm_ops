# ============================================================
# 大模型监测管理平台 — 环境变量配置
# 复制为 .env 后按需修改，切勿提交真实密码到 Git！
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=llmops
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=ai_platform

# ---------- Redis ----------
REDIS_PASSWORD=change_me_to_strong_password

# ---------- RabbitMQ ----------
RABBITMQ_USER=llmops
RABBITMQ_PASSWORD=change_me_to_strong_password

# ---------- 应用安全 ----------
# JWT 密钥：生产必须替换为随机长串，例如：openssl rand -hex 32
SECRET_KEY=please_change_me_to_random_secret
JWT_EXPIRE_MINUTES=60

# ---------- CORS（前端来源，逗号分隔）----------
CORS_ORIGINS=http://localhost

# ---------- 端口 ----------
# 前端对外端口（80 默认；如 80 被占用改为 8080）
WEB_PORT=80

# ---------- 运行参数 ----------
API_WORKERS=2
CELERY_CONCURRENCY=4

# ---------- Higress ----------
# 网关控制面地址（本项目后端需要向 Higress 同步路由时使用）
HIGRESS_ADMIN_API=http://higress-gateway:8080/api
